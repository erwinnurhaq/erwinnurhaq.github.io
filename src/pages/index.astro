---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const featuredProjects = (await getCollection('projects'))
  .filter((p) => !p.data.draft && p.data.featured)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const latestPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const fmtDate = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<Layout title="erwww.in | Frontend Engineer" description="Erwin Nurhaq — frontend engineer in Jakarta. I turn wireframes into fast, friendly interfaces." page="home">
  <!-- HERO -->
  <section class="hero">
    <div>
      <p class="kicker"><span class="dot"></span> Open for freelance — Jakarta / remote</p>
      <h1>I make interfaces that <span class="italic">feel good</span> to <span class="strike">ship</span> use.</h1>
      <p class="sub">
        Hi, I'm <b>Erwin Nurhaq</b>. I turn rough wireframes into fast, friendly web apps.
      </p>
      <div class="cta-row">
        <a class="btn btn-solid" href="/projects/">View work →</a>
        <a class="btn btn-ghost" href="#contact">Say hello</a>
      </div>
      <div class="micro mono">
        <span>↳ Jakarta, GMT+7</span>
        <span>↳ ok with any timezone</span>
      </div>
    </div>

    <div class="card-wrap">
      <aside class="index-card" id="index-card">
        <div class="card-head"><span>Index card — № 001</span><span>erwww.in</span></div>
        <dl>
          <div class="card-row"><dt>Name</dt><dd><strong>Erwin Nurhaq</strong></dd></div>
          <div class="card-row"><dt>Base</dt><dd>Jakarta, ID — GMT+7</dd></div>
          <div class="card-row"><dt>Stack</dt><dd>TypeScript · React · Next.js · Node</dd></div>
          <div class="card-row"><dt>Elsewhere</dt><dd><a class="text-link" href="https://github.com/erwinnurhaq" target="_blank" rel="noreferrer">github</a> · <a class="text-link" href="https://linkedin.com/in/erwinnurhaq" target="_blank" rel="noreferrer">linkedin</a></dd></div>
          <div class="card-row"><dt>Status</dt><dd>→ open for projects</dd></div>
        </dl>
        <p class="hand">Right now: frontend work, mostly TypeScript and React.<span class="cursor-blink"></span></p>
      </aside>
      <span class="card-scribble">← that's me, on paper</span>
    </div>
  </section>

  <!-- TICKER (single marquee) -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track" id="ticker">
      <span>TypeScript ✳ React ✳ Next.js ✳ Tailwind ✳ Node ✳ Bun ✳ Astro ✳&nbsp;</span>
      <span>TypeScript ✳ React ✳ Next.js ✳ Tailwind ✳ Node ✳ Bun ✳ Astro ✳&nbsp;</span>
    </div>
  </div>

  <!-- 01 NOTES -->
  <section class="section reveal">
    <div class="sec-head">
      <span class="sec-no">01</span>
      <div>
        <h2>Things I pay attention to.</h2>
        <p>Habits kept from past projects.</p>
      </div>
    </div>
    <div class="notes">
      <div class="note">
        <span class="note-no">/a</span>
        <div>
          <h3>Writing things down.</h3>
          <p>Decisions, trade-offs, and what changed — noted where the next person can find them, so nobody has to guess later.</p>
        </div>
      </div>
      <div class="note">
        <span class="note-no">/b</span>
        <div>
          <h3>The unglamorous states.</h3>
          <p>Loading, empty, and error states are part of the build from the start, along with keyboard and reduced-motion support.</p>
        </div>
      </div>
      <div class="note">
        <span class="note-no">/c</span>
        <div>
          <h3>Real devices, slow networks.</h3>
          <p>I check work on an actual phone and a throttled connection, since that's how most of it gets visited.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 WORK -->
  <section class="section reveal">
    <div class="sec-head">
      <span class="sec-no">02</span>
      <div>
        <h2>Selected work.</h2>
        <p>A short reel. Full case notes on the work page.</p>
      </div>
    </div>
    <div class="ledger-head"><span>№ — Project</span><span>Stack / role</span></div>
    <div class="ledger">
      {featuredProjects.map((project, i) => (
        <a class="row" href={`/projects/${project.slug}/`}>
          <span class="row-no">{String(i + 1).padStart(2, '0')}</span>
          <span class="row-title">{project.data.title}<small>{project.data.description}</small></span>
          <span class="row-meta">{project.data.stack}<br />{project.data.role} <span class="row-arrow">↗</span></span>
        </a>
      ))}
    </div>
    <p style="margin-top:1.2rem; font-family:var(--mono); font-size:0.85rem;">
      <a class="text-link" href="/projects/">Full archive →</a>
    </p>
  </section>

  <!-- 03 PROCESS + WRITING teaser split -->
  <section class="section reveal">
    <div class="sec-head">
      <span class="sec-no">03</span>
      <div>
        <h2>How projects usually go.</h2>
      </div>
    </div>
    <div class="letter">
      <p>Most projects start the same way: I read what's already there — the code, if it exists, and whatever numbers there are. What people actually use, what's slow, what's already working. The part I'm least sure about gets built first, while it's still cheap to change direction.</p>
      <p>After that it's small increments, each with a note on what changed and why. Updates arrive in writing, with a link you can open. I'm in Jakarta (GMT+7) and work async by default — calls when text isn't enough, in English or Indonesian.</p>
    </div>
  </section>

  <!-- 04 WRITING -->
  <section class="section reveal">
    <div class="sec-head">
      <span class="sec-no">04</span>
      <div>
        <h2>Writing.</h2>
        <p>Notes on portfolios, Figma handoffs, and micro-interactions. No growth-hack listicles.</p>
      </div>
    </div>
    <div class="posts">
      {latestPosts.map((post) => (
        <a class="post-row" href={`/blog/${post.slug}/`}>
          <time>{fmtDate(post.data.date)}</time>
          <strong>{post.data.title}</strong>
          <span class="tag">{post.data.tags[0] ?? 'note'}</span>
        </a>
      ))}
    </div>
    <p style="margin-top:1.2rem; font-family:var(--mono); font-size:0.85rem;">
      <a class="text-link" href="/blog/">All notes →</a>
    </p>
  </section>

  <!-- CONTACT -->
  <section class="contact reveal" id="contact">
    <p class="mono contact-no">05 — Say hello.</p>
    <h2>Got something half-sketched? Let's finish it together.</h2>
    <p>Freelance, contract, or a weird experiment that needs a frontend. Send a paragraph about what you're making — I'll reply with honest thoughts, even if we don't work together.</p>
    <a class="mail-big" href="mailto:mail@erwww.in">mail@erwww.in</a>
    <div class="contact-links">
      <button class="copy-text" id="copy-email" type="button">[copy]</button>
      <a href="https://github.com/erwinnurhaq" target="_blank" rel="noreferrer">github ↗</a>
      <a href="https://linkedin.com/in/erwinnurhaq" target="_blank" rel="noreferrer">linkedin ↗</a>
    </div>
    <p class="contact-sign">— Erwin</p>
  </section>
</Layout>
