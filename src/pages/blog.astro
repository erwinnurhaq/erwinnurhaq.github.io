---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatYear = (date: Date) => date.getFullYear().toString();
const formatDay = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
---

<Layout title="Blog" description="Notes on frontend engineering, design, and building for the web." page="blog">
  <section class="back-navigation">
    <p><a href="/">← home</a></p>
  </section>

  <section class="page-head">
    <p class="mono" style="font-size:0.76rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--muted);">Notebook — {posts.length} entries</p>
    <h1>Writing.</h1>
    <p>Short notes from the trenches. What broke, what worked, what I'd do differently.</p>
  </section>

  <section style="padding-bottom:3rem;">
    {
      posts.map((post, index) => {
        const prev = posts[index - 1];
        const showYear = !prev || post.data.date.getFullYear() !== prev.data.date.getFullYear();
        return (
          <>
            {showYear && <h2 class="year-heading">{formatYear(post.data.date)}</h2>}
            <div class="post-item">
              <p>
                <a href={`/blog/${post.slug}/`} class="post-title">{post.data.title}</a>
                <span class="date">{formatDay(post.data.date)}</span>
              </p>
              <p class="post-excerpt">{post.data.excerpt}</p>
              <p style="font-family:var(--mono); font-size:0.82rem; margin-top:0.4rem;"><a class="text-link" href={`/blog/${post.slug}/`}>Read →</a></p>
            </div>
          </>
        );
      })
    }
  </section>
</Layout>
