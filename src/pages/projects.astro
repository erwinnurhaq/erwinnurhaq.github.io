---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { slugOf } from '../utils/slug';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout title="Projects" description="Selected frontend engineering work by Erwin Nurhaq." page="projects">
  <section class="back-navigation">
    <p><a href="/">← home</a></p>
  </section>

  <section class="page-head">
    <p class="mono" style="font-size:0.76rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--muted);">Archive — {projects.length} projects</p>
    <h1>Work.</h1>
    <p>Things I've designed, built, or rescued. Live links where they're still breathing.</p>
  </section>

  <section style="padding-bottom:3rem;">
    <div class="ledger-head"><span>№ — Project</span><span>Stack / role</span></div>
    <div class="ledger">
      {projects.map((project, i) => (
        <a class="row" href={`/projects/${slugOf(project)}/`}>
          <span class="row-no">{String(i + 1).padStart(2, '0')}</span>
          <span class="row-title">{project.data.title}<small>{project.data.description}</small></span>
          <span class="row-meta">{project.data.stack}<br />{project.data.role} <span class="row-arrow">↗</span></span>
        </a>
      ))}
    </div>
  </section>
</Layout>
