---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found" description="This page doesn't exist. Back to erwww.in." page="home" showFooter={true}>
  <section class="page-head">
    <p class="mono" style="font-size:0.76rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--muted);">404 — nothing here</p>
    <h1>Lost? Same.</h1>
    <p>This page doesn't exist or moved. The work and writing are still around though.</p>
    <div class="cta-row" style="margin-top:1.4rem;">
      <a class="btn btn-solid" href="/">Back home →</a>
      <a class="btn btn-ghost" href="/projects/">View work</a>
    </div>
  </section>
</Layout>
