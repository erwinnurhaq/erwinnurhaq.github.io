---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  page?: 'home' | 'blog' | 'post' | 'projects' | 'project';
  showFooter?: boolean;
}

const { title, description = "Erwin Nurhaq — Frontend Engineer in Jakarta. I make interfaces that feel good to use.", page = 'home', showFooter = true } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, 'https://erwww.in').href;
const folioYear = new Date().getFullYear().toString().slice(2);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title === "erwww.in | Frontend Engineer" ? title : `${title} | erwww.in`}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Erwin Nurhaq" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#121211" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <!-- External file (not inlined): the site is served with a
         Content-Security-Policy that blocks inline scripts. This classic
         script blocks parsing by design, so the theme applies pre-paint. -->
    <script is:inline src="/theme-boot.js"></script>
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>

  <body data-page={page}>
    <div class="progress" id="progress"></div>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">
          <span class="brand-mark">e.</span>
          <span>erwww.in <small>— folio ’{folioYear}</small></span>
        </a>
        <nav class="nav">
          <a class="hide-m" href="/projects/">work</a>
          <a class="hide-m" href="/blog/">writing</a>
          <a href="/#contact">contact</a>
          <span class="clock" id="clock" title="Jakarta time">--:--</span>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <div class="main-container">
      <slot />
      {showFooter && <Footer />}
    </div>

    <!-- External files (not inlined/bundled): CSP blocks inline scripts. -->
    <script is:inline src="/main.js" defer></script>
  </body>
</html>
